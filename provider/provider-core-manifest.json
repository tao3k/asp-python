{
  "schemaId": "agent.semantic-protocols.provider-core-manifest",
  "schemaVersion": "1",
  "languageId": "python",
  "providerId": "asp-python",
  "displayName": "Python",
  "extensions": [".py", ".pyi"],
  "projectMarkers": ["pyproject.toml"],
  "syntaxSurface": {
    "lineComment": "#",
    "delimiterPairs": [["(", ")"], ["[", "]"], ["{", "}"]],
    "stringDelimiters": ["\"", "'"]
  },
  "transport": {
    "transport": "http-json",
    "command": ["serve"],
    "healthPath": "/health",
    "requestPath": "/v1/provider-runtime",
    "shutdownPath": "/shutdown"
  },
  "capabilities": {
    "astInspect": true,
    "astVerify": true,
    "openEdb": true,
    "projectResolution": true
  }
}
